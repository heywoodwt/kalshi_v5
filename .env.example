# Kalshi API Credentials
# Get your API key and private key from: https://kalshi.com/profile/api

PROD_API_KEY=your_kalshi_api_key_here
PROD_KEY_PATH=rsa_keys/your_private_key.pem

# Trading mode (true = paper trading, false = live)
PAPER_TRADING=true

# Market filter (KXBTC = Bitcoin markets)
MARKET_PREFIX=KXBTC